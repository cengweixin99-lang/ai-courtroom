# 本地镜像源不可用时，复用已验证的 API 运行时，仅更新当前应用代码。
ARG API_LOCAL_RUNTIME_IMAGE=mootcourt-lab-api:local-runtime
FROM ${API_LOCAL_RUNTIME_IMAGE}

WORKDIR /app

COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations

# 本地运行时镜像可能是旧版本，显式补齐 Redis 与指标依赖，保证源码升级后仍可启动。
RUN python -m pip install --no-cache-dir "redis>=5,<6" "prometheus-client>=0.21,<1"

# 基础镜像已经包含全部运行依赖，直接加载当前源码以彻底避免访问包仓库。
ENV PYTHONPATH=/app/src

CMD ["sh", "-c", "alembic upgrade head && uvicorn mootcourt.main:app --host 0.0.0.0 --port 8000"]
