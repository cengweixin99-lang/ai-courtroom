# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=["http://localhost:5173"]

# MySQL
MYSQL_DATABASE=mootcourt
MYSQL_USER=mootcourt
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=3307
DATABASE_URL=mysql+aiomysql://mootcourt:change-me@mysql:3306/mootcourt

# Elasticsearch 8.19.10
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=mootcourt
ELASTICSEARCH_LEGAL_INDEX_VERSION=v1
ELASTICSEARCH_TIMEOUT_SECONDS=10

# Legal embeddings. Disabled by default; indexing and search remain BM25-only.
LEGAL_EMBEDDING_ENABLED=false
LEGAL_EMBEDDING_REGISTRY_PATH=knowledge/legal/embedding_models.json
LEGAL_EMBEDDING_PROVIDER=openai-compatible
LEGAL_EMBEDDING_MODEL=
LEGAL_EMBEDDING_API_KEY=
LEGAL_EMBEDDING_BASE_URL=
LEGAL_EMBEDDING_VERSION=disabled
LEGAL_EMBEDDING_DIMENSIONS=1024
LEGAL_EMBEDDING_TIMEOUT_SECONDS=30
LEGAL_EMBEDDING_BATCH_SIZE=32
# Elasticsearch cosine similarity 原始阈值；返回 _score = (1 + cosine) / 2。
LEGAL_VECTOR_SIMILARITY_THRESHOLD=0.78
LEGAL_HYBRID_CANDIDATE_MULTIPLIER=4
LEGAL_RRF_RANK_CONSTANT=60

# 阿里云百炼 Qwen 的 OpenAI-compatible 配置；密钥只填写在本地 .env 或密钥服务中。
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_RETRIES=2
LLM_MAX_INCOMPLETE_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_TOKENS_FIELD=max_tokens
# Qwen Agent 的结构化输出关闭隐藏思考，避免高延迟和无效 completion token 消耗。
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0
# 按实际模型价格填写；为 0 时只记录 Token，不估算费用。
LLM_INPUT_COST_PER_MILLION_CNY=0
LLM_OUTPUT_COST_PER_MILLION_CNY=0
# 会话级 Agent 租约；应覆盖一次模型调用、自动重试和结构修复的最长预期时间。
AGENT_INVOCATION_LEASE_SECONDS=900

# Per-session hard limits
SESSION_MAX_TURNS=40
SESSION_MAX_TOKENS=80000
SESSION_MAX_SECONDS=2400
SESSION_MAX_COST_CNY=20

# Browser-side API address
VITE_API_BASE_URL=/api/v1
