# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=["http://localhost:5173"]

# MySQL
MYSQL_DATABASE=mootcourt
MYSQL_USER=mootcourt
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DATABASE_URL=mysql+aiomysql://mootcourt:change-me@mysql:3306/mootcourt

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=mootcourt
OPENSEARCH_INITIAL_ADMIN_PASSWORD=LocalDevOnly-ChangeMe1!

# Model provider. Keep keys in .env; never commit them.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Per-session hard limits
SESSION_MAX_TURNS=40
SESSION_MAX_TOKENS=80000
SESSION_MAX_SECONDS=2400
SESSION_MAX_COST_CNY=20

# Browser-side API address
VITE_API_BASE_URL=http://localhost:8000/api/v1
