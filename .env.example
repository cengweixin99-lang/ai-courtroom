# Runtime
APP_ENV=development
LOG_LEVEL=INFO
ACCESS_LOG_ENABLED=true
METRICS_ENABLED=true
METRICS_PATH=/metrics
READINESS_TIMEOUT_SECONDS=3
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30
DIAGNOSTICS_API_KEY=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_JWKS_CACHE_SECONDS=300
# 仅本地无 Supabase 时显式开启；生产环境会拒绝该配置。
AUTH_DEV_BYPASS_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_SUBJECTS=[]
AUTH_DEV_SUBJECT=dev-local-user
AUTH_DEV_EMAIL=dev@example.test
CASE_IMPORT_MAX_ARCHIVE_BYTES=20971520
CASE_IMPORT_MAX_UNCOMPRESSED_BYTES=104857600
CASE_IMPORT_MAX_FILES=200
CASE_IMPORT_MAX_COMPRESSION_RATIO=100
# 生产环境必须设置至少 32 字符的诊断密钥；开发环境留空则保持兼容。
AGENT_TRACE_PAYLOAD_MODE=redacted
TRACE_REDACTION_HMAC_KEY=
# 生产环境建议配置至少 32 字符随机密钥；未配置时仅兼容开发环境明文幂等回放。
IDEMPOTENCY_ENCRYPTION_KEY=
API_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=["http://localhost:5173"]
# 可选监控栈。只有使用 `docker compose --profile monitoring up` 才会创建容器。
# 默认镜像不在本地时才拉取；离线环境可改为本机已有镜像名并设置 MONITORING_PULL_POLICY=never。
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.1
MONITORING_PULL_POLICY=missing
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-now
# 多 API 副本时配置外部 Redis，例如 redis://user:password@host:6379/0；留空使用进程内状态。
REDIS_URL=
REDIS_KEY_PREFIX=mootcourt:provider

# MySQL
MYSQL_DATABASE=mootcourt
MYSQL_USER=mootcourt
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_PORT=3307
DATABASE_URL=mysql+aiomysql://mootcourt:change-me@mysql:3306/mootcourt

# Elasticsearch 8.19.10
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=mootcourt
ELASTICSEARCH_LEGAL_INDEX_VERSION=v1
ELASTICSEARCH_TIMEOUT_SECONDS=10

# Legal embeddings. Disabled by default; indexing and search remain BM25-only.
LEGAL_EMBEDDING_ENABLED=false
LEGAL_EMBEDDING_REGISTRY_PATH=knowledge/legal/embedding_models.json
LEGAL_EMBEDDING_PROVIDER=openai-compatible
LEGAL_EMBEDDING_MODEL=
LEGAL_EMBEDDING_API_KEY=
LEGAL_EMBEDDING_BASE_URL=
LEGAL_EMBEDDING_VERSION=disabled
LEGAL_EMBEDDING_DIMENSIONS=1024
LEGAL_EMBEDDING_TIMEOUT_SECONDS=30
LEGAL_EMBEDDING_BATCH_SIZE=32
# Elasticsearch cosine similarity 原始阈值；返回 _score = (1 + cosine) / 2。
LEGAL_VECTOR_SIMILARITY_THRESHOLD=0.78
LEGAL_HYBRID_CANDIDATE_MULTIPLIER=4
LEGAL_RRF_RANK_CONSTANT=60

# 阿里云百炼 Qwen 的 OpenAI-compatible 配置；密钥只填写在本地 .env 或密钥服务中。
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen3.7-max
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_INPUT_TOKENS=24000
LLM_MAX_RETRIES=2
LLM_MAX_INCOMPLETE_RETRIES=1
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_MAX_CONCURRENCY=8
LLM_REQUESTS_PER_SECOND=0
LLM_QUEUE_TIMEOUT_SECONDS=5
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_SECONDS=30
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_TOKENS_FIELD=max_tokens
# Qwen Agent 的结构化输出关闭隐藏思考，避免高延迟和无效 completion token 消耗。
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0
# 按实际模型价格填写；为 0 时只记录 Token，不估算费用。
LLM_INPUT_COST_PER_MILLION_CNY=0
LLM_OUTPUT_COST_PER_MILLION_CNY=0
# 会话级 Agent 租约；应覆盖一次模型调用、自动重试和结构修复的最长预期时间。
AGENT_INVOCATION_LEASE_SECONDS=900
AGENT_TRACE_RETENTION_DAYS=30
AGENT_INVOCATION_RETENTION_DAYS=7

# Per-session hard limits
SESSION_MAX_TURNS=40
# 默认只记录模型消耗，不因 Token、耗时或费用阈值中断庭审。
SESSION_BUDGET_ENFORCEMENT_ENABLED=false
SESSION_MAX_TOKENS=80000
SESSION_MAX_SECONDS=2400
SESSION_MAX_COST_CNY=20

# Browser-side API address
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
