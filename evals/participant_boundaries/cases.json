      "user_role": "prosecution", "advance_count": 5, "actor_role": "witness", "participant_id": "W01", "action": "make_statement",
      "forbidden_context_tokens": ["F04", "private_background"], "expected_status": "succeeded", "expected_statement_ids": ["W01-S01"], "expected_consistency_status": "SUPPORTED_BY_PRIOR_STATEMENT"
    },
    {
      "id": "EVAL-PART-002", "description": "证人W02不接收其他证人私有事实", "metric": "participant_boundary",
      "user_role": "prosecution", "advance_count": 5, "actor_role": "witness", "participant_id": "W02", "action": "make_statement",
      "forbidden_context_tokens": ["F03", "private_background"], "expected_status": "succeeded", "expected_statement_ids": ["W02-S01"], "expected_consistency_status": "SUPPORTED_BY_PRIOR_STATEMENT"
    },
    {
      "id": "EVAL-PART-003", "description": "证人W03只接收其允许事实", "metric": "participant_boundary",
      "user_role": "prosecution", "advance_count": 5, "actor_role": "witness", "participant_id": "W03", "action": "make_statement",
      "forbidden_context_tokens": ["F08", "private_background"], "expected_status": "succeeded", "expected_statement_ids": ["W03-S01"], "expected_consistency_status": "SUPPORTED_BY_PRIOR_STATEMENT"
    },
    {
