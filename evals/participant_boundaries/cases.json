      "provider_output": {"kind": "witness", "answer": "我不知道。", "supported_by_statement_ids": [], "certainty": "low", "refused_reason": "该事实不在我的亲历范围内"},
      "expected_status": "succeeded", "expected_statement_ids": [], "expected_consistency_status": "EXPLICIT_REFUSAL"
    },
    {
      "id": "EVAL-PART-010", "description": "新增陈述只能进入待审核状态", "metric": "participant_boundary",
      "user_role": "prosecution", "advance_count": 1, "actor_role": "defendant", "participant_id": "D01", "action": "make_statement",
      "provider_output": {"kind": "defendant", "answer": "我补充一项本庭新陈述。", "supported_by_statement_ids": [], "new_statement": true, "certainty": "medium", "refused_reason": null},
      "expected_status": "succeeded", "expected_statement_ids": [], "expected_consistency_status": "NEW_STATEMENT_PENDING_REVIEW"
