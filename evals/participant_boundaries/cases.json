      "user_role": "prosecution", "advance_count": 1, "actor_role": "defendant", "participant_id": "D01", "action": "make_statement",
      "forbidden_context_tokens": ["private_background", "forbidden_fact_ids"], "expected_status": "succeeded", "expected_statement_ids": ["D01-S01"], "expected_consistency_status": "SUPPORTED_BY_PRIOR_STATEMENT"
    },
    {
      "id": "EVAL-PART-005", "description": "证人角色不得绑定被告人", "metric": "participant_boundary",
      "user_role": "prosecution", "advance_count": 5, "actor_role": "witness", "participant_id": "D01", "action": "make_statement",
      "expected_status": "rejected", "expected_code": "participant_role_mismatch"
    },
    {
      "id": "EVAL-PART-006", "description": "被告人角色不得绑定证人", "metric": "participant_boundary",
      "user_role": "prosecution", "advance_count": 1, "actor_role": "defendant", "participant_id": "W01", "action": "make_statement",
      "expected_status": "rejected", "expected_code": "participant_role_mismatch"
    },
    {
      "id": "EVAL-PART-007", "description": "用户控制角色不得再次调用同角色Agent", "metric": "participant_boundary",
      "user_role": "prosecution", "advance_count": 2, "actor_role": "prosecution", "action": "make_statement",
      "expected_status": "rejected", "expected_code": "user_controlled_role"
    },
    {
      "id": "EVAL-PART-008", "description": "证人不得引用不可见陈述", "metric": "participant_boundary",
      "user_role": "prosecution", "advance_count": 5, "actor_role": "witness", "participant_id": "W01", "action": "make_statement",
      "provider_output": {"kind": "witness", "answer": "越权回答", "supported_by_statement_ids": ["W02-S01"], "certainty": "high", "refused_reason": null},
      "expected_status": "failed", "expected_code": "agent_output_forbidden"
    },
    {
