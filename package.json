{
  "name": "mootcourt-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:coverage": "npm run test:coverage --workspace frontend",
    "api:dev": "docker compose up --build api",
    "infra:up": "docker compose up -d mysql opensearch",
    "infra:down": "docker compose down",
    "compose:check": "docker compose config --quiet"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
