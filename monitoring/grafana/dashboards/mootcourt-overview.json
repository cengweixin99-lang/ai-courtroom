{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "mootcourt-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "HTTP 请求速率",
      "type": "timeseries",
      "targets": [{"expr": "sum(rate(mootcourt_http_requests_total{job=\"mootcourt-api\"}[5m]))", "legendFormat": "全部请求", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "mootcourt-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 0.05}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "HTTP 5xx 比例",
      "type": "timeseries",
      "targets": [{"expr": "sum(rate(mootcourt_http_requests_total{job=\"mootcourt-api\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(mootcourt_http_requests_total{job=\"mootcourt-api\"}[5m])), 0.001)", "legendFormat": "5xx", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "mootcourt-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "title": "Agent 成功回合 p95 延迟",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(mootcourt_agent_turn_duration_seconds_bucket{job=\"mootcourt-api\",status=\"succeeded\"}[10m])))", "legendFormat": "p95", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "mootcourt-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "title": "Agent Token 消耗",
      "type": "timeseries",
      "targets": [{"expr": "sum by (direction) (rate(mootcourt_agent_tokens_total{job=\"mootcourt-api\"}[10m]))", "legendFormat": "{{direction}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "mootcourt-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "id": 5,
      "title": "Provider 重试",
      "type": "stat",
      "targets": [{"expr": "sum(increase(mootcourt_agent_provider_retries_total{job=\"mootcourt-api\"}[1h]))", "legendFormat": "最近 1 小时", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "mootcourt-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "id": 6,
      "title": "Guard 拒绝",
      "type": "stat",
      "targets": [{"expr": "sum(increase(mootcourt_agent_provider_guard_rejections_total{job=\"mootcourt-api\"}[1h]))", "legendFormat": "最近 1 小时", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "mootcourt-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "id": 7,
      "title": "输出归一化",
      "type": "stat",
      "targets": [{"expr": "sum(increase(mootcourt_agent_output_normalizations_total{job=\"mootcourt-api\"}[1h]))", "legendFormat": "最近 1 小时", "refId": "A"}]
    }
  ],
