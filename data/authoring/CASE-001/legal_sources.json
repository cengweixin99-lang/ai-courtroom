  "legal_sources": [
    {
      "id": "LS-CRIMINAL-LAW-13",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑法（国家法律法规数据库现行有效记录）",
      "article_number": "第十三条",
      "text_snapshot": "一切危害国家主权、领土完整和安全，分裂国家、颠覆人民民主专政的政权和推翻社会主义制度，破坏社会秩序和经济秩序，侵犯国有财产或者劳动群众集体所有的财产，侵犯公民私人所有的财产，侵犯公民的人身权利、民主权利和其他权利，以及其他危害社会的行为，依照法律应当受刑罚处罚的，都是犯罪，但是情节显著轻微危害不大的，不认为是犯罪。",
      "effective_from": "2021-03-01",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92&title=中华人民共和国刑法",
      "issuer": "全国人民代表大会常务委员会",
      "publication_date": "2020-12-26",
      "official_record_id": "ff808181796a636a0179822a19640c92",
      "pdf_page_number": 8,
      "pdf_end_page_number": 9,
      "source_type": "official_npc_law_database",
      "authority_level": "law_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14",
      "version_hash": "2252A75F5549DBD9F902F74C9B9943ADFDE33729F600C62F3E8C24EA204A5456"
    },
    {
      "id": "LS-CRIMINAL-LAW-14",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑法（国家法律法规数据库现行有效记录）",
      "article_number": "第十四条",
      "text_snapshot": "明知自己的行为会发生危害社会的结果，并且希望或者放任这种结果发生，因而构成犯罪的，是故意犯罪。故意犯罪，应当负刑事责任。",
      "effective_from": "2021-03-01",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92&title=中华人民共和国刑法",
      "issuer": "全国人民代表大会常务委员会",
      "publication_date": "2020-12-26",
      "official_record_id": "ff808181796a636a0179822a19640c92",
      "pdf_page_number": 9,
      "source_type": "official_npc_law_database",
      "authority_level": "law_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14",
      "version_hash": "2252A75F5549DBD9F902F74C9B9943ADFDE33729F600C62F3E8C24EA204A5456"
    },
    {
      "id": "LS-CRIMINAL-LAW-17-1",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑法（国家法律法规数据库现行有效记录）",
      "article_number": "第十七条第一款",
      "text_snapshot": "已满十六周岁的人犯罪，应当负刑事责任。",
      "effective_from": "2021-03-01",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92&title=中华人民共和国刑法",
      "issuer": "全国人民代表大会常务委员会",
      "publication_date": "2020-12-26",
      "official_record_id": "ff808181796a636a0179822a19640c92",
      "pdf_page_number": 9,
      "source_type": "official_npc_law_database",
