      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14",
      "version_hash": "2252A75F5549DBD9F902F74C9B9943ADFDE33729F600C62F3E8C24EA204A5456"
    },
    {
      "id": "LS-CRIMINAL-LAW-264",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑法（国家法律法规数据库现行有效记录）",
      "article_number": "第二百六十四条",
      "text_snapshot": "盗窃公私财物，数额较大的，或者多次盗窃、入户盗窃、携带凶器盗窃、扒窃的，处三年以下有期徒刑、拘役或者管制，并处或者单处罚金；数额巨大或者有其他严重情节的，处三年以上十年以下有期徒刑，并处罚金；数额特别巨大或者有其他特别严重情节的，处十年以上有期徒刑或者无期徒刑，并处罚金或者没收财产。",
      "effective_from": "2021-03-01",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/detail?id=ff808181796a636a0179822a19640c92&title=中华人民共和国刑法",
      "issuer": "全国人民代表大会常务委员会",
      "publication_date": "2020-12-26",
      "official_record_id": "ff808181796a636a0179822a19640c92",
      "pdf_page_number": 73,
      "source_type": "official_npc_law_database",
      "authority_level": "law_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14",
      "version_hash": "2252A75F5549DBD9F902F74C9B9943ADFDE33729F600C62F3E8C24EA204A5456"
    },
    {
      "id": "LS-THEFT-INTERPRETATION-2013-1",
      "jurisdiction": "PRC",
      "instrument_title": "最高人民法院、最高人民检察院关于办理盗窃刑事案件适用法律若干问题的解释",
      "document_number": "法释〔2013〕8号",
      "article_number": "第一条第一款、第二款",
      "text_snapshot": "盗窃公私财物价值一千元至三千元以上、三万元至十万元以上、三十万元至五十万元以上的，应当分别认定为刑法第二百六十四条规定的“数额较大”、“数额巨大”、“数额特别巨大”。各省、自治区、直辖市高级人民法院、人民检察院可以根据本地区经济发展状况，并考虑社会治安状况，在前款规定的数额幅度内，确定本地区执行的具体数额标准，报最高人民法院、最高人民检察院批准。",
      "effective_from": "2013-04-04",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/",
      "issuer": "最高人民法院、最高人民检察院",
      "source_type": "official_npc_law_database_online_record",
      "authority_level": "judicial_interpretation_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14",
      "development_note": "本案估价12800元高于各地可采用的数额较大标准上限3000元，故开发基线不依赖上海具体数额标准。"
    },
    {
      "id": "LS-THEFT-INTERPRETATION-2013-4-1",
      "jurisdiction": "PRC",
      "instrument_title": "最高人民法院、最高人民检察院关于办理盗窃刑事案件适用法律若干问题的解释",
      "document_number": "法释〔2013〕8号",
      "article_number": "第四条第一项",
      "text_snapshot": "被盗财物有有效价格证明的，根据有效价格证明认定；无有效价格证明，或者根据价格证明认定盗窃数额明显不合理的，应当按照有关规定委托估价机构估价。",
      "effective_from": "2013-04-04",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/",
      "issuer": "最高人民法院、最高人民检察院",
      "source_type": "official_npc_law_database_online_record",
      "authority_level": "judicial_interpretation_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14"
    },
    {
      "id": "LS-CPL-50",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑事诉讼法",
      "article_number": "第五十条",
      "text_snapshot": "可以用于证明案件事实的材料，都是证据。证据包括：（一）物证；（二）书证；（三）证人证言；（四）被害人陈述；（五）犯罪嫌疑人、被告人供述和辩解；（六）鉴定意见；（七）勘验、检查、辨认、侦查实验等笔录；（八）视听资料、电子数据。证据必须经过查证属实，才能作为定案的根据。",
      "effective_from": "2018-10-26",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/",
      "issuer": "全国人民代表大会",
      "source_type": "official_npc_law_database_online_record",
      "authority_level": "law_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14"
    },
    {
      "id": "LS-CPL-51",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑事诉讼法",
      "article_number": "第五十一条",
      "text_snapshot": "公诉案件中被告人有罪的举证责任由人民检察院承担，自诉案件中被告人有罪的举证责任由自诉人承担。",
      "effective_from": "2018-10-26",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/",
      "issuer": "全国人民代表大会",
      "source_type": "official_npc_law_database_online_record",
      "authority_level": "law_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14"
    },
    {
      "id": "LS-CPL-55",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑事诉讼法",
      "article_number": "第五十五条",
      "text_snapshot": "对一切案件的判处都要重证据，重调查研究，不轻信口供。只有被告人供述，没有其他证据的，不能认定被告人有罪和处以刑罚；没有被告人供述，证据确实、充分的，可以认定被告人有罪和处以刑罚。证据确实、充分，应当符合以下条件：（一）定罪量刑的事实都有证据证明；（二）据以定案的证据均经法定程序查证属实；（三）综合全案证据，对所认定事实已排除合理怀疑。",
      "effective_from": "2018-10-26",
      "effective_to": null,
      "official_source_url": "https://flk.npc.gov.cn/",
      "issuer": "全国人民代表大会",
      "source_type": "official_npc_law_database_online_record",
      "authority_level": "law_current_official",
      "status": "effective",
      "review_status": "verified",
      "verified_as_of_date": "2026-07-14"
    },
    {
      "id": "LS-CRIMINAL-LAW-264-2009-HISTORICAL",
      "jurisdiction": "PRC",
      "instrument_title": "中华人民共和国刑法（全国人民代表大会常务委员会公报2009·专刊）",
      "article_number": "第二百六十四条",
      "text_snapshot": "盗窃公私财物，数额较大或者多次盗窃的，处三年以下有期徒刑、拘役或者管制，并处或者单处罚金；数额巨大或者有其他严重情节的，处三年以上十年以下有期徒刑，并处罚金；数额特别巨大或者有其他特别严重情节的，处十年以上有期徒刑或者无期徒刑，并处罚金或者没收财产；有下列情形之一的，处无期徒刑或者死刑，并处没收财产：（一）盗窃金融机构，数额特别巨大的；（二）盗窃珍贵文物，情节严重的。",
      "effective_from": null,
      "effective_to": null,
